#!/usr/bin/env bash
# `swarm-worker-agent` — run a checkout's worker as a launchd LaunchAgent, so it
# starts at login instead of occupying a terminal tab (docs/launchd-worker-autostart.md).
#
# It is a wrapper around `swarm run:worker`, not a second launcher: the agent runs
# that command with the checkout as its working directory, which is what lets the
# credential stay in the per-checkout cache instead of being written into a plist.
set -euo pipefail

usage() {
	cat <<'EOF'
swarm-worker-agent -- launchd autostart for a SWARM worker checkout (macOS)

Usage:
  swarm-worker-agent install   [<checkout>]   write the agent and start it
  swarm-worker-agent uninstall [<checkout>]   stop it and remove the agent
  swarm-worker-agent status    [<checkout>]   show whether it is loaded/running
  swarm-worker-agent logs      [<checkout>]   tail this checkout's worker log

<checkout> is the repository checkout the worker was registered for, and defaults
to the current directory. Each checkout gets its own agent, so a machine running
workers for several repositories installs one per checkout.
EOF
}

die() { printf 'swarm-worker-agent: %s\n' "$1" >&2; exit 1; }

# The checkout's realpath is the credential cache's key, the daemon's checkout-lock
# key, the plist's WorkingDirectory, and the seed for a label unique per checkout.
resolve() {
	[ -d "${1:-$PWD}" ] || die "no such directory: ${1:-$PWD}"
	CHECKOUT=$(cd "${1:-$PWD}" && pwd -P)
	local hash
	hash=$(printf '%s' "$CHECKOUT" | shasum -a 256 | cut -d' ' -f1)
	CACHE="$HOME/.swarm/worker-credentials/$hash/credential.json"
	# The daemon's own lock on the checkout it serves (src/worktree/checkout-lock.ts,
	# issue #689) -- the credential cache's sibling, keyed by that same hash
	# (src/worktree/checkout-key.ts states the convention once for both), and the only
	# host-local record of which repository a running daemon actually serves.
	LOCK="$HOME/.swarm/checkout-locks/$hash/owner.json"
	LABEL="pl.smarttechbrewery.swarm.worker.$(basename "$CHECKOUT").${hash:0:8}"
	PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
	LOG="$HOME/Library/Logs/$LABEL.log"
	TARGET="gui/$(id -u)/$LABEL"
}

# launchd starts a job with a minimal PATH and none of the login shell's rc files,
# while the worker spawns npm, git, gh and the agent CLIs by name. Resolving each
# here rather than hard-coding a prefix is what makes the agent portable across
# Macs: an Intel Homebrew (/usr/local), an Apple Silicon one (/opt/homebrew) and a
# node under nvm/asdf/fnm all land on their real directories.
agent_path() {
	local dirs=() bin resolved dir seen
	for bin in node npm git gh claude codex agy; do
		resolved=$(command -v "$bin" 2>/dev/null) || continue
		dirs+=("$(dirname "$resolved")")
	done
	dirs+=("$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin)

	seen=""
	for dir in "${dirs[@]}"; do
		case ":$seen:" in *":$dir:"*) continue ;; esac
		seen="${seen:+$seen:}$dir"
	done
	printf '%s' "$seen"
}

# Whether this checkout's own agent is currently running. `install` boots that job
# out below before bootstrapping the new one, so its daemon is never the second
# worker the guard is about -- and reinstalling over a live agent is the routine way
# the plist is changed (a moved node, a new agent CLI on PATH).
agent_running() {
	launchctl print "$TARGET" 2>/dev/null | grep -qE '^[[:space:]]+pid = [0-9]+'
}

# Whether the lock's own `refreshedAt` has lapsed -- the freshness half of the
# daemon's reclaim rule (CHECKOUT_LOCK_TTL_MS, src/worktree/checkout-lock.ts, kept
# in step with this literal by tests/unit/worker/worker-agent-lock-guard.test.ts).
# The holder rewrites that stamp every five minutes, so a lapsed one means a
# departed daemon whose pid the OS has since handed to *another* worker -- the one
# case liveness alone gets wrong, and a real one on a machine running a worker per
# checkout. The daemon reclaims such a lock instead of refusing to start, so the
# installer has to agree or it refuses an install the very daemon it is installing
# would then complete. An unreadable stamp counts as lapsed, exactly as `isExpired`
# (src/worktree/local-lock.ts) treats an unparseable one: a record that cannot be
# trusted to bound anything must not block an operator either.
#
# `-v-15M` is BSD date's arithmetic and `-d` GNU's; both are kept so the guard can
# be exercised off a Mac. Both stamps are `toISOString` output -- fixed width, UTC,
# zero-padded -- so comparing the first 19 characters as plain strings orders them
# correctly without parsing a date in shell.
lock_lapsed() {
	local refreshed cutoff
	refreshed=$(sed -n 's/.*"refreshedAt":[[:space:]]*"\([^"]*\)".*/\1/p' "$LOCK" 2>/dev/null | head -1 || true)
	[ -n "$refreshed" ] || return 0
	cutoff=$(date -u -v-15M +%Y-%m-%dT%H:%M:%S 2>/dev/null ||
		date -u -d '15 minutes ago' +%Y-%m-%dT%H:%M:%S)
	[[ "${refreshed:0:19}" < "$cutoff" ]]
}

# A worker already running by hand holds the checkout lock; a second one would lose
# the race and then crash-loop under KeepAlive.
#
# The lock is what says which checkout a daemon serves, and it is the only thing
# that does: `swarm run:worker` spawns the daemon in the npm-linked SWARM checkout,
# so every worker on the machine reports *that* directory as its cwd whichever
# repository it serves. Comparing cwd therefore refused the SWARM checkout's own
# install by naming an unrelated repository's daemon, and guarded no other checkout
# at all (issue #969). `ps` rather than `pgrep` for liveness for a second reason
# found there: macOS pgrep excludes its own ancestors, so a daemon that spawned the
# session running this command is invisible to it -- and one `ps` call answers both
# halves of the liveness question at once, since a pid running something that is not
# a worker cannot be this lock's holder. A lock left behind by a crashed daemon
# refuses nothing, exactly as the next daemon reclaims it rather than refusing to
# start -- at once when its pid is gone, and once the record lapses when that pid has
# been recycled to another worker.
refuse_if_worker_running() {
	[ -f "$LOCK" ] || return 0
	local holder who
	holder=$(sed -n 's/.*"pid":[[:space:]]*\([0-9]\{1,\}\).*/\1/p' "$LOCK" 2>/dev/null | head -1 || true)
	[ -n "$holder" ] || return 0
	ps -ww -p "$holder" -o command= 2>/dev/null | grep -q 'src/transport/connect-entry' || return 0
	lock_lapsed && return 0
	agent_running && return 0
	# Named the way the daemon's own refusal names a holder (`describeHolder`,
	# src/worktree/checkout-lock.ts): by worker id when the lock has one, since that
	# is what an operator can act on; by pid alone before its first handshake.
	# `"workerId":null` leaves this empty (the pattern requires the opening quote), so
	# a daemon that has not handshaked yet keeps the wording the cwd guard used.
	who=$(sed -n 's/.*"workerId":"\([^"]*\)".*/\1/p' "$LOCK" 2>/dev/null | head -1 || true)
	who="${who:+worker $who}"
	die "${who:-a worker} (pid $holder) is already running for $CHECKOUT -- stop it first, then re-run install"
}

cmd_install() {
	# A worker checkout is a git checkout of the *project* repository (the daemon
	# declares its `origin` at handshake); it is not necessarily a Node project, so
	# .git is the invariant to check, not package.json.
	[ -e "$CHECKOUT/.git" ] || die "not a git checkout: $CHECKOUT"
	# Without a cached credential the agent would start, fail, and be restarted by
	# launchd forever.
	[ -f "$CACHE" ] || die "no worker registered for $CHECKOUT
  register one from that checkout first:
    swarm workers register-and-enroll <owner-identifier> <project-id> --name <name> --cli <clis>"

	local node swarm
	node=$(command -v node) || die 'node not found on PATH'
	swarm=$(command -v swarm) || die 'swarm not found on PATH'

	refuse_if_worker_running

	mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
	cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>

	<key>ProgramArguments</key>
	<array>
		<string>$node</string>
		<string>$swarm</string>
		<string>run:worker</string>
	</array>

	<key>WorkingDirectory</key>
	<string>$CHECKOUT</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>$(agent_path)</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>StandardOutPath</key>
	<string>$LOG</string>
	<key>StandardErrorPath</key>
	<string>${LOG%.log}.error.log</string>
</dict>
</plist>
EOF
	plutil -lint "$PLIST" >/dev/null || die "generated plist is invalid: $PLIST"

	launchctl bootout "$TARGET" 2>/dev/null || true
	launchctl bootstrap "gui/$(id -u)" "$PLIST"
	printf 'swarm-worker-agent: installed %s\n  checkout: %s\n  log:      %s\n' \
		"$LABEL" "$CHECKOUT" "$LOG"
}

cmd_uninstall() {
	[ -f "$PLIST" ] || die "no agent installed for $CHECKOUT"
	launchctl bootout "$TARGET" 2>/dev/null || true
	rm -f "$PLIST"
	printf 'swarm-worker-agent: removed %s (logs kept at %s)\n' "$LABEL" "$LOG"
}

cmd_status() {
	[ -f "$PLIST" ] || die "no agent installed for $CHECKOUT"
	printf 'label:    %s\ncheckout: %s\n' "$LABEL" "$CHECKOUT"
	launchctl print "$TARGET" 2>/dev/null | grep -E '^[[:space:]]+(state|pid|last exit code) ' ||
		echo 'state = not loaded'
}

cmd_logs() {
	[ -f "$LOG" ] || die "no log yet at $LOG"
	tail -f "$LOG" "${LOG%.log}.error.log"
}

[ "$(uname -s)" = 'Darwin' ] || die 'launchd is macOS-only; on Linux use a systemd --user unit running `swarm run:worker`'

case "${1:-}" in
	install | uninstall | status | logs)
		action=$1
		shift
		checkout=''
		for arg in "$@"; do
			case "$arg" in
				-*) die "unknown option: $arg" ;;
				*)
					[ -z "$checkout" ] || die "only one <checkout> may be given"
					checkout=$arg
					;;
			esac
		done
		resolve "${checkout:-$PWD}"
		"cmd_$action"
		;;
	-h | --help | help | '') usage ;;
	*)
		usage
		exit 1
		;;
esac
