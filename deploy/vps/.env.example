# SWARM on a VPS behind Caddy — environment for deploy/vps/docker-compose.yml.
# Copy to .env beside docker-compose.yml and keep it private:
#   cp .env.example .env && chmod 600 .env
# Walkthrough: docs/MANUAL.md, "Running on a VPS behind Caddy".
#
# DATABASE_URL, REDIS_URL, PORT and DATABASE_SSL are NOT set here: the compose
# file assembles them from the passwords below and overrides any value in this file.

# --- Required ---

# Image tag of ghcr.io/smarttechbrewery/swarm: a vX.Y.Z release or a sha-<7>
# commit tag, or `stable` (the newest release) when whoever upgrades the app
# cannot edit this file — a pull then upgrades it with no edit. Never `main` on a
# server — it moves many times a day. See docs/MANUAL.md, "The published image".
SWARM_IMAGE_TAG=

# SWARM's public base URL: scheme + host only, no trailing slash or path. It is
# Caddy's site address (the certificate is issued for this host), the base of
# every webhook and worker URL, and the prefix of the first-run setup link. A DNS
# A/AAAA record for the host must point at this server.
WEBHOOK_CALLBACK_BASE_URL=https://swarm.example.com

# Postgres password. Generate with: openssl rand -hex 32
# Hex on purpose — it is embedded in a connection URL, where other characters
# would need escaping. Applied only when the Postgres volume is first created.
POSTGRES_PASSWORD=

# Redis password (Redis is started with --requirepass). Generate the same way,
# hex for the same reason: openssl rand -hex 32
REDIS_PASSWORD=

# 32-byte (64-char) hex key that encrypts every stored credential (AES-256-GCM).
# The app refuses to start without a valid one. Generate with either:
#   openssl rand -hex 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# BACK IT UP SEPARATELY FROM THE DATABASE. A database backup is useless without
# it, and losing or changing it makes every stored credential undecryptable.
CREDENTIAL_MASTER_KEY=

# --- Safe defaults (keep as they are) ---

# Multi-user session auth. The all-in-one control plane refuses to start with
# this set to true — single-user mode is for a local install only.
SWARM_SINGLE_USER_MODE=false

# --- Optional ---

# Minimum log level (debug|info|warn|error).
#SWARM_LOG_LEVEL=info

# Dashboard and `swarm login` session lifetime, in hours (default 7 days).
#SWARM_SESSION_TTL_HOURS=168

# Any other general setting in docs/configuration.md can be added here too — this
# whole file is passed to the app.
